                            power-source = <0x0>;
                            phandle = <0x1FA>;
                        };
                    };
                    cam_sensor_eldo3 {
                        cam_sensor_eldo3_default {
                            pins = "gpio3";
                            function = "normal";
                            output-high;
                            bias-disable;
                            phandle = <0x171>;
                        };
