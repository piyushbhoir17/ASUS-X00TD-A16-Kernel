        i2c6 = "/soc/i2c@c1b6000";
        i2c7 = "/soc/i2c@c1b7000";
        i2c8 = "/soc/i2c@c1b8000";
    };
    memory {
        device_type = "memory";
        reg = <0x0 0x0 0x0 0x0>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    energy-costs {
        compatible = "sched-energy";
        core-cost0 {
            busy-cost-data = <0x9AB00 0x2B 0xDC500 0x3E 0x10FE00 0x50 0x156300 0x7B 0x177000 0x90 0x189C00 0xA0 0x1C2000 0xB7>;
            phandle = <0x2>;
