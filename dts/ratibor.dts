    vendor {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        ranges = <0x0 0x0 0x0 0xFFFFFFFF>;
        compatible = "simple-bus";
    };
    firmware {
        android {
            compatible = "android,firmware";
            boot_devices = "soc/c0c4000.sdhci";
            vbmeta {
                compatible = "android,vbmeta";
                parts = "vbmeta,boot,system,vendor,dtbo";
                status = "disabled";
            };
            fstab {
                vendor {
                    fsmgr_flags = "wait";
                };
                system {
                    compatible = "android,system";
                    dev = "/dev/block/platform/soc/c0c4000.sdhci/by-name/system";
                    type = "ext4";
                    mnt_flags = "ro,barrier=1,discard";
                    fsmgr_flags = "wait";
                    status = "ok";
                };
                system_ext {
                    compatible = "android,system_ext";
                    dev = "/dev/block/platform/soc/c0c4000.sdhci/by-name/system_ext";
                    type = "ext4";
                    mnt_flags = "ro,barrier=1,discard";
                    fsmgr_flags = "wait";
                    status = "ok";
                };
                product {
                    compatible = "android,product";
                    dev = "/dev/block/platform/soc/c0c4000.sdhci/by-name/product";
                    type = "ext4";
                    mnt_flags = "ro,barrier=1,discard";
                    fsmgr_flags = "wait";
                    status = "ok";
                };
            };
        };
    };
